---
import Base from '../../layouts/Base.astro';

const modules = [
  { n: '01', title: 'Nền tảng TikTok Ads', topics: ['Tổng quan TikTok Ads Manager và TikTok Business Center', 'Thiết lập tài khoản quảng cáo, phân quyền và phương thức thanh toán', 'Hiểu cấu trúc chiến dịch, nhóm quảng cáo và mẫu quảng cáo'] },
  { n: '02', title: 'Thiết lập chiến dịch quảng cáo', topics: ['Lựa chọn mục tiêu quảng cáo video, lưu lượng truy cập và chuyển đổi', 'Xây dựng đối tượng khách hàng, ngân sách và lịch chạy', 'Thực hành tạo, kiểm tra và xuất bản chiến dịch phù hợp'] },
  { n: '03', title: 'TikTok Shop Ads', topics: ['Tổng quan quảng cáo bán hàng dành cho TikTok Shop', 'Thiết lập chiến dịch theo tính năng và điều kiện tài khoản hiện có', 'Theo dõi đơn hàng, chi phí và hiệu quả bán hàng'] },
  { n: '04', title: 'Quảng cáo TikTok LIVE', topics: ['Chuẩn bị phiên livestream và thiết lập quảng cáo LIVE', 'Lựa chọn mục tiêu tăng người xem hoặc thúc đẩy bán hàng', 'Đọc số liệu, điều chỉnh ngân sách và tối ưu trong phiên LIVE'] },
  { n: '05', title: 'Sáng tạo nội dung quảng cáo', topics: ['Xây dựng video thu hút đúng khách hàng mục tiêu', 'Viết kịch bản, tối ưu 3 giây đầu và lời kêu gọi hành động', 'Thử nghiệm nhiều nội dung và đánh giá kết quả'] },
  { n: '06', title: 'Đo lường và tối ưu nâng cao', topics: ['Hiểu CPM, CPC, CTR, CPA và ROAS trong từng mục tiêu', 'Phân tích nguyên nhân chiến dịch hoạt động chưa hiệu quả', 'Quản lý ngân sách, mở rộng chiến dịch và xử lý sự cố thường gặp'] }
];

const audiences = [
  'Người mới muốn bắt đầu học quảng cáo TikTok',
  'Chủ shop và người kinh doanh online',
  'Người bán hàng trên TikTok Shop và livestream',
  'Nhân viên marketing và người làm dịch vụ quảng cáo'
];

const phone = '+84966064236';
const zalo = 'https://zalo.me/84966064236';
const whatsappVN = 'https://wa.me/84966064236?text=' + encodeURIComponent('Xin chào H&L Media Academy, tôi muốn được tư vấn khóa học TikTok Ads toàn diện.');
const whatsappLA = 'https://wa.me/8562099602210?text=' + encodeURIComponent('Xin chào H&L Media Academy, tôi muốn được tư vấn khóa học TikTok Ads toàn diện.');
---

<Base lang="vi" title="Khóa học TikTok Ads toàn diện thực chiến | H&L Media Academy" description="Khóa học TikTok Ads toàn diện tại H&L Media Academy: TikTok Ads Manager, quảng cáo video, TikTok Shop Ads, TikTok LIVE, sáng tạo nội dung và tối ưu chiến dịch. Liên hệ tư vấn.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">H&L MEDIA ACADEMY · TIKTOK ADS</span>
        <h1>Khóa học <span>TikTok Ads</span> toàn diện thực chiến</h1>
        <p>Từ thiết lập quảng cáo video đến TikTok Shop và TikTok LIVE: học cách xây dựng, vận hành, đo lường và tối ưu chiến dịch theo mục tiêu kinh doanh thực tế.</p>
        <div class="actions">
          <a class="btn primary" href="#tu-van">Liên hệ tư vấn khóa học</a>
          <a class="btn outline" href="#chuong-trinh">Xem chương trình học</a>
        </div>
        <div class="tags"><span>✓ Hướng dẫn từng bước</span><span>✓ Thực hành chiến dịch</span><span>✓ Video · Shop · LIVE</span></div>
      </div>
      <div class="visual" aria-label="Minh họa chương trình đào tạo TikTok Ads">
        <div class="visual-top"><span>TIKTOK ADS TRAINING</span><span class="dot"></span></div>
        <div class="visual-mark">♪</div>
        <strong>Learn · Launch · Optimize</strong>
        <div class="mini-grid"><div><small>01</small><b>Video Ads</b></div><div><small>02</small><b>Shop Ads</b></div><div><small>03</small><b>LIVE Ads</b></div></div>
      </div>
    </div>
  </section>

  <section class="section" id="doi-tuong"><div class="wrap">
    <div class="heading"><span class="eyebrow blue">DÀNH CHO AI?</span><h2>Ai nên tham gia khóa học?</h2><p>Lộ trình phù hợp cho người bắt đầu, người kinh doanh và người muốn nâng cao kỹ năng vận hành quảng cáo TikTok.</p></div>
    <div class="audiences">{audiences.map((item, i) => <div class="audience"><span class="number">0{i + 1}</span><p>{item}</p></div>)}</div>
  </div></section>

  <section class="section pale" id="chuong-trinh"><div class="wrap">
    <div class="heading"><span class="eyebrow blue">6 HỌC PHẦN THỰC CHIẾN</span><h2>Lộ trình học TikTok Ads toàn diện</h2><p>Học từ nền tảng tài khoản, triển khai chiến dịch đến TikTok Shop, livestream và tối ưu kết quả.</p></div>
    <div class="modules">{modules.map(module => <article class="module"><div class="module-head"><span>{module.n}</span><h3>{module.title}</h3></div><ul>{module.topics.map(topic => <li>{topic}</li>)}</ul></article>)}</div>
    <p class="note">Nội dung thực hành và tính năng quảng cáo có thể thay đổi theo quốc gia, loại tài khoản, điều kiện sử dụng và cập nhật của TikTok.</p>
  </div></section>

  <section class="section"><div class="wrap split">
    <div><span class="eyebrow blue">PHƯƠNG PHÁP ĐÀO TẠO</span><h2>Học để tự triển khai, đọc số liệu và tối ưu</h2><p class="lead">Chương trình tập trung vào cách ra quyết định khi chạy quảng cáo, không chỉ học thao tác. Học viên được hướng dẫn thực hành theo mục tiêu phù hợp với mô hình kinh doanh.</p></div>
    <div class="steps">
      <div><b>01</b><div><h3>Hiểu nền tảng</h3><p>Nắm mục tiêu quảng cáo, cấu trúc chiến dịch và cách lựa chọn hình thức phù hợp.</p></div></div>
      <div><b>02</b><div><h3>Thực hành có hướng dẫn</h3><p>Thiết lập chiến dịch video, Shop và LIVE khi tài khoản đáp ứng điều kiện.</p></div></div>
      <div><b>03</b><div><h3>Phân tích và cải thiện</h3><p>Đọc chỉ số, thử nghiệm nội dung và xây dựng phương án tối ưu ngân sách.</p></div></div>
    </div>
  </div></section>

  <section class="cta" id="tu-van"><div class="wrap cta-inner">
    <span class="eyebrow">ĐĂNG KÝ TƯ VẤN</span>
    <h2>Bắt đầu lộ trình TikTok Ads phù hợp với bạn</h2>
    <p>Liên hệ H&L Media Academy để trao đổi về chương trình học, hình thức đào tạo, lịch học và học phí. Học phí không hiển thị công khai trên website.</p>
    <div class="actions centered">
      <a class="btn light" href={zalo} target="_blank" rel="noopener noreferrer">Tư vấn qua Zalo</a>
      <a class="btn outline" href={whatsappVN} target="_blank" rel="noopener noreferrer">WhatsApp Việt Nam</a>
      <a class="btn outline" href={whatsappLA} target="_blank" rel="noopener noreferrer">WhatsApp Lào</a>
      <a class="btn outline" href={`tel:${phone}`}>Gọi +84 966 064 236</a>
    </div>
  </div></section>

  <style>
    .wrap{width:min(1160px,92%);margin:auto}.hero{background:linear-gradient(125deg,#071b3e,#104c9b);color:#fff;padding:92px 0}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.eyebrow{display:inline-block;font-size:12px;font-weight:800;letter-spacing:1.6px;color:#61d5ff;margin-bottom:17px}.eyebrow.blue{color:#1263df}h1{font-size:clamp(34px,4.6vw,58px);line-height:1.18;margin:0 0 24px;letter-spacing:-1px}h1 span{color:#60d8ff}.hero p{font-size:16px;line-height:1.9;color:#d7e6fa;max-width:640px}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;text-align:center;border-radius:10px;padding:14px 20px;font-size:14px;font-weight:700;transition:transform .2s}.btn:hover{transform:translateY(-2px)}.primary{background:#26c3ff;color:#071b3e}.outline{border:1px solid #a5c8ec;color:#fff}.tags{display:flex;flex-wrap:wrap;gap:15px;margin-top:28px;color:#d8eaff;font-size:12px}.visual{min-height:355px;border-radius:24px;padding:30px;border:1px solid #699dd6;background:linear-gradient(155deg,#2059a2,#0a2148);box-shadow:0 25px 60px #00132955;display:flex;flex-direction:column;justify-content:space-between}.visual-top{display:flex;justify-content:space-between;font-size:11px;letter-spacing:2px;color:#b2e9ff}.dot{height:10px;width:10px;border-radius:50%;background:#54d8ff}.visual-mark{font-size:115px;line-height:1;font-weight:800;color:#73dcff;text-align:center}.visual>strong{text-align:center;font-size:22px}.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.mini-grid>div{background:#ffffff14;border:1px solid #ffffff22;border-radius:10px;padding:13px;display:grid;gap:5px}.mini-grid small{color:#86dfff}.mini-grid b{font-size:12px}.section{padding:80px 0}.pale{background:#f1f6fd}.heading{text-align:center;max-width:760px;margin:0 auto 38px}h2{font-size:clamp(27px,3.4vw,39px);line-height:1.35;margin:0 0 15px}.heading p,.lead{color:#60738a;line-height:1.9}.audiences{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.audience{padding:27px;border:1px solid #e1e9f3;border-radius:15px;background:#fff}.number{color:#1263df;font-weight:800;font-size:22px}.audience p{font-weight:600;line-height:1.75}.modules{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.module{padding:30px;background:#fff;border:1px solid #e1e9f3;border-radius:16px}.module-head{display:flex;gap:15px;align-items:center}.module-head span{color:#1263df;font-weight:800;font-size:20px}.module h3{font-size:20px;margin:0}.module ul{padding-left:22px;color:#5e7086;line-height:1.95}.module li{margin:8px 0}.note{font-size:13px;color:#65778d;margin-top:20px}.split{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}.steps{display:grid;gap:15px}.steps>div{display:flex;gap:18px;background:#f6f9fe;border-radius:14px;padding:20px}.steps b{font-size:23px;color:#1263df}.steps h3{margin:0 0 5px}.steps p{margin:0;color:#60738a;line-height:1.7}.cta{padding:80px 0;background:#0c2854;color:#fff;text-align:center}.cta-inner{max-width:800px}.cta p{color:#d7e6fa;line-height:1.85}.centered{justify-content:center}.light{background:#27c3ff;color:#092144}@media(max-width:900px){.hero-grid,.split{grid-template-columns:1fr;gap:30px}.audiences,.modules{grid-template-columns:repeat(2,1fr)}.hero{padding:65px 0}.section{padding:60px 0}}@media(max-width:600px){.audiences,.modules{grid-template-columns:1fr}.visual{min-height:300px;padding:22px}.mini-grid{gap:6px}.mini-grid>div{padding:9px}.mini-grid b{font-size:10px}.actions .btn{width:100%}}
  </style>
</Base>

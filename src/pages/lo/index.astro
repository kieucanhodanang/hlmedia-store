
---
import Base from '../../layouts/Base.astro';

const courses = [
  {
    number: '01',
    title: 'Facebook Ads',
    description: 'ຮຽນຮູ້ວິທີສ້າງແຄມເປນໂຄສະນາ ກຳນົດກຸ່ມລູກຄ້າເປົ້າໝາຍ ຈັດການງົບປະມານ ແລະ ວັດຜົນການໂຄສະນາ.',
    url: '/lo/facebook-ads/'
  },
  {
    number: '02',
    title: 'TikTok Ads',
    description: 'ຝຶກປະຕິບັດການສ້າງໂຄສະນາ TikTok ການສ້າງເນື້ອຫາ ການວິເຄາະຂໍ້ມູນ ແລະ ປັບປຸງແຄມເປນ.',
    url: '/lo/tiktok-ads/'
  },
  {
    number: '03',
    title: 'Combo Facebook + TikTok',
    description: 'ຫຼັກສູດລວມສອງແພລດຟອມ ເພື່ອພັດທະນາທັກສະການໂຄສະນາຫຼາຍຊ່ອງທາງສຳລັບທຸລະກິດ.',
    url: '/lo/combo/'
  }
];

const benefits = [
  'ຮຽນຈາກພື້ນຖານໄປສູ່ການປະຕິບັດຈິງ',
  'ຝຶກສ້າງແຄມເປນໂຄສະນາດ້ວຍຕົນເອງ',
  'ຮຽນວິທີວິເຄາະ ແລະ ປັບປຸງງົບໂຄສະນາ',
  'ນຳຄວາມຮູ້ໄປໃຊ້ກັບທຸລະກິດຈິງ',
  'ມີການແນະນຳ ແລະ ຕອບຄຳຖາມໃນລະຫວ່າງຮຽນ',
  'ເໝາະສຳລັບຜູ້ເລີ່ມຕົ້ນ ແລະ ເຈົ້າຂອງຮ້ານອອນລາຍ'
];
---

<Base
  lang="lo"
  title="H&L Media Academy | ຫຼັກສູດ Facebook Ads ແລະ TikTok Ads"
  description="ຮຽນໂຄສະນາ Facebook Ads ແລະ TikTok Ads ກັບ H&L Media Academy ຈາກພື້ນຖານເຖິງຂັ້ນສູງ ເນັ້ນການຝຶກປະຕິບັດຈິງ."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">H&L MEDIA ACADEMY</span>
        <h1>
          ຮຽນຮູ້ການໂຄສະນາ
          <span>Facebook Ads & TikTok Ads</span>
        </h1>
        <p>
          ຮຽນການໂຄສະນາຈາກພື້ນຖານເຖິງຂັ້ນສູງ
          ຝຶກສ້າງແຄມເປນ ຈັດການງົບປະມານ
          ແລະ ປັບປຸງປະສິດທິພາບການໂຄສະນາ.
        </p>

        <div class="actions">
          <a class="btn primary" href="#courses">
            ເບິ່ງຫຼັກສູດ
          </a>
          <a class="btn secondary" href="#register">
            ລົງທະບຽນຮັບຄຳປຶກສາ
          </a>
        </div>

        <div class="hero-tags">
          <span>✓ ເນັ້ນການປະຕິບັດຈິງ</span>
          <span>✓ ແນະນຳທຸກຂັ້ນຕອນ</span>
          <span>✓ ຫວຽດນາມ & ລາວ</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="visual-label">DIGITAL ADS TRAINING</div>
        <div class="visual-title">
          ພັດທະນາທັກສະ<br />
          ການໂຄສະນາດິຈິຕອນ
        </div>
        <div class="platforms">
          <div class="platform">
            <strong>f</strong>
            <span>Facebook Ads</span>
          </div>
          <div class="platform">
            <strong>♪</strong>
            <span>TikTok Ads</span>
          </div>
        </div>
        <div class="visual-bottom">
          LEARN · PRACTICE · OPTIMIZE
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="courses">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">ຫຼັກສູດຝຶກອົບຮົມ</span>
        <h2>ເລືອກຫຼັກສູດທີ່ເໝາະກັບທ່ານ</h2>
        <p>
          ຫຼັກສູດເນັ້ນຄວາມຮູ້ ແລະ ທັກສະ
          ທີ່ສາມາດນຳໄປໃຊ້ໃນວຽກງານຈິງ.
        </p>
      </div>

      <div class="course-grid">
        {courses.map(course => (
          <article class="course-card">
            <div class="course-number">{course.number}</div>
            <h3>{course.title}</h3>
            <p>{course.description}</p>
            <a href={course.url}>ເບິ່ງລາຍລະອຽດ →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="container benefits-grid">
      <div>
        <span class="eyebrow">ຮຽນເພື່ອນຳໃຊ້ຈິງ</span>
        <h2>ເປັນຫຍັງຈຶ່ງເລືອກ H&L Media Academy?</h2>
        <p class="muted">
          ພວກເຮົາເນັ້ນການຮຽນຮູ້ຜ່ານການຝຶກປະຕິບັດ
          ເພື່ອໃຫ້ຜູ້ຮຽນສາມາດສ້າງ ແລະ ປັບປຸງແຄມເປນ
          ໂຄສະນາດ້ວຍຕົນເອງ.
        </p>
      </div>

      <div class="benefit-list">
        {benefits.map(benefit => (
          <div class="benefit-item">
            <span class="check">✓</span>
            <span>{benefit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">ຂັ້ນຕອນການຮຽນ</span>
        <h2>ຮຽນເປັນຂັ້ນຕອນ ຝຶກປະຕິບັດທຸກຂັ້ນຕອນ</h2>
      </div>

      <div class="steps">
        <div class="step">
          <span>01</span>
          <h3>ຮຽນຮູ້ພື້ນຖານ</h3>
          <p>ເຂົ້າໃຈບັນຊີໂຄສະນາ ເປົ້າໝາຍ ແລະ ໂຄງສ້າງແຄມເປນ.</p>
        </div>
        <div class="step">
          <span>02</span>
          <h3>ຝຶກປະຕິບັດຈິງ</h3>
          <p>ຝຶກສ້າງໂຄສະນາ ເນື້ອຫາ ແລະ ເລືອກກຸ່ມເປົ້າໝາຍ.</p>
        </div>
        <div class="step">
          <span>03</span>
          <h3>ວິເຄາະ ແລະ ປັບປຸງ</h3>
          <p>ອ່ານຄ່າສະຖິຕິ ຄວບຄຸມຄ່າໃຊ້ຈ່າຍ ແລະ ປັບປຸງແຄມເປນ.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section" id="register">
    <div class="container cta-inner">
      <span class="eyebrow">ເລີ່ມຮຽນໄດ້ເລີຍ</span>
      <h2>ພ້ອມພັດທະນາທັກສະການໂຄສະນາແລ້ວບໍ?</h2>
      <p>
        ຄົ້ນຫາຫຼັກສູດ Facebook Ads ແລະ TikTok Ads
        ທີ່ເໝາະກັບເປົ້າໝາຍຂອງທ່ານ.
      </p>
      <a class="btn cta-button" href="/lo/lien-he/">
        ລົງທະບຽນຮັບຄຳປຶກສາ →
      </a>
    </div>
  </section>

  <style>
    .container {
      width: min(1160px, 92%);
      margin: auto;
    }
    .hero {
      background: linear-gradient(125deg, #071b3e, #104c9b);
      color: white;
      padding: 100px 0;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .eyebrow {
      display: inline-block;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #48c8ff;
      margin-bottom: 20px;
    }
    h1 {
      font-size: clamp(36px, 5vw, 62px);
      line-height: 1.2;
      margin: 0 0 24px;
    }
    h1 span {
      display: block;
      color: #52d6ff;
    }
    .hero p {
      font-size: 17px;
      line-height: 1.9;
      color: #d5e5fa;
    }
    .actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 30px;
    }
    .btn {
      display: inline-flex;
      justify-content: center;
      padding: 15px 23px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 14px;
    }
    .primary {
      background: #23b9ff;
      color: #071b3e;
    }
    .secondary {
      border: 1px solid #8db7e5;
      color: white;
    }
    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 35px;
      font-size: 13px;
      color: #d7eaff;
    }
    .hero-visual {
      min-height: 360px;
      border: 1px solid #5286c5;
      border-radius: 24px;
      padding: 35px;
      background: linear-gradient(145deg, #174c91, #071c3f);
      box-shadow: 0 30px 70px #00152e70;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .visual-label {
      font-size: 12px;
      letter-spacing: 2px;
      color: #8ee5ff;
    }
    .visual-title {
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 800;
      line-height: 1.4;
      margin: 25px 0;
    }
    .platforms {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .platform {
      background: #ffffff12;
      border: 1px solid #ffffff35;
      border-radius: 14px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .platform strong {
      font-size: 32px;
      color: #54d9ff;
    }
    .platform span {
      font-weight: 700;
      font-size: 14px;
    }
    .visual-bottom {
      margin-top: 30px;
      font-size: 11px;
      letter-spacing: 2px;
      color: #9cbce2;
    }
    .section {
      padding: 85px 0;
    }
    .section-heading {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 45px;
    }
    .section-heading .eyebrow,
    .benefits-section .eyebrow {
      color: #1263df;
    }
    h2 {
      font-size: clamp(28px, 3.5vw, 40px);
      line-height: 1.35;
      margin: 0 0 18px;
    }
    .section-heading p,
    .muted {
      color: #63748b;
      line-height: 1.9;
    }
    .course-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    .course-card {
      padding: 32px;
      border: 1px solid #e0e8f3;
      border-radius: 18px;
      background: white;
      box-shadow: 0 12px 30px #123b6b0a;
    }
    .course-number {
      color: #1263df;
      font-size: 14px;
      font-weight: 800;
      margin-bottom: 35px;
    }
    .course-card h3 {
      font-size: 22px;
      margin: 0 0 15px;
    }
    .course-card p {
      color: #63748b;
      line-height: 1.9;
      min-height: 165px;
    }
    .course-card a {
      color: #1263df;
      font-weight: 700;
      font-size: 14px;
    }
    .benefits-section {
      background: #f1f6fd;
    }
    .benefits-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }
    .benefit-list {
      display: grid;
      gap: 14px;
    }
    .benefit-item {
      background: white;
      border-radius: 12px;
      padding: 17px;
      display: flex;
      align-items: center;
      gap: 15px;
      font-weight: 600;
    }
    .check {
      display: inline-grid;
      place-items: center;
      background: #e2f3ff;
      color: #0877d7;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
    }
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }
    .step {
      padding: 28px;
      border-left: 3px solid #1263df;
      background: #f8fbff;
      border-radius: 0 12px 12px 0;
    }
    .step > span {
      font-size: 30px;
      font-weight: 800;
      color: #1263df;
    }
    .step h3 {
      font-size: 20px;
    }
    .step p {
      color: #63748b;
      line-height: 1.8;
    }
    .cta-section {
      background: #0c2854;
      color: white;
      text-align: center;
      padding: 85px 0;
    }
    .cta-inner {
      max-width: 780px;
    }
    .cta-inner p {
      color: #d5e5fa;
      line-height: 1.9;
      margin-bottom: 28px;
    }
    .cta-button {
      background: #28c2ff;
      color: #092144;
    }
    @media (max-width: 900px) {
      .hero {
        padding: 65px 0;
      }
      .hero-grid,
      .benefits-grid {
        grid-template-columns: 1fr;
        gap: 35px;
      }
      .course-grid,
      .steps {
        grid-template-columns: 1fr;
      }
      .course-card p {
        min-height: auto;
      }
      .section {
        padding: 60px 0;
      }
      .hero-visual {
        min-height: 300px;
      }
    }
    @media (max-width: 480px) {
      .platforms {
        grid-template-columns: 1fr;
      }
      .hero-visual {
        padding: 24px;
      }
    }
  </style>
</Base>
